# ==============================================================================
# Environment Configuration - Music Genre Classification
# ==============================================================================

# Dataset Configuration
DATASET_PATH=data/genres_original
DATA_OUTPUT_NPZ=data/data_mfcc.npz
DATA_OUTPUT_JSON=data/data_mfcc.json

# Audio Processing Hyperparameters
SAMPLE_RATE=22050
TRACK_DURATION_SEC=30
SEGMENT_DURATION_SEC=3
NUM_SEGMENTS=10
N_MFCC=40
N_FFT=2048
HOP_LENGTH=512

# Model & Training Settings
MODEL_DIR=models
MODEL_FILE=models/music_genre_cnn.keras
MAPPING_FILE=models/genre_mapping.json
BATCH_SIZE=32
EPOCHS=50
LEARNING_RATE=0.0001

# Application Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
